# Saeed AI · Telegram bot — environment variables
# Copy to .env (never commit .env) and fill in real values.
# Supabase Edge Functions read these from project secrets
# (`supabase secrets set KEY=value`), not from this file.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Google Gemini API key (required; audio always uses Gemini)
GEMINI_API_KEY=

# OpenRouter API key (optional; enables the OpenRouter chat provider)
OPENROUTER_API_KEY=

# Supabase project URL of the same project the functions deploy to
SUPABASE_URL=

# Service role key (server-side only). Newer projects may instead provide
# SUPABASE_SECRET_KEYS as JSON: {"default":"<service role key>"}
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Telegram numeric user IDs allowed to chat with the bot
# (legacy bootstrap list; runtime additions live in telegram_bot_user_access)
TELEGRAM_ALLOWED_USER_ID=

# Admin Telegram numeric user id (falls back to the first legacy ID above)
TELEGRAM_ADMIN_USER_ID=
