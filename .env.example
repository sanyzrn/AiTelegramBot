# Saeed AI · Telegram bot — environment variables
# Copy to .env (never commit .env) and fill in real values.
# Supabase Edge Functions read these from project secrets
# (`supabase secrets set KEY=value`), not from this file.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key (required when the active provider is Gemini; also powers
# voice-out TTS while Gemini is active). Provider-first (v10.3.0): with
# OpenRouter active, no request is ever sent to Gemini.
GEMINI_API_KEY=

# OpenRouter API key (required when the active provider is OpenRouter).
# The selected model's input modalities (image/audio/pdf) are detected
# automatically and incompatible tools explain themselves precisely.
OPENROUTER_API_KEY=

# Supabase project URL of the same project the functions deploy to
SUPABASE_URL=

# Service role key (server-side only). Newer projects may instead provide
# SUPABASE_SECRET_KEYS as JSON: {"default":"<service role key>"}
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Telegram numeric user IDs allowed to chat with the bot
# (legacy bootstrap list; runtime additions live in telegram_bot_user_access)
TELEGRAM_ALLOWED_USER_ID=

# Admin Telegram numeric user id (falls back to the first legacy ID above)
TELEGRAM_ADMIN_USER_ID=

# ---- Optional (v10) ----
# GitHub token (read-only, public repos) for the repo-audit tool: raises the
# shared-IP limit from 60 to 5000 GitHub API requests per hour.
GITHUB_TOKEN=

# HTTPS URL of the hosted Mini App dashboard (webapp/index.html) including
# ?api=https://<project-ref>.supabase.co/functions/v1/saeed-ai-webapp
# When set, the home keyboard and the chat menu button open the dashboard.
WEBAPP_URL=

# Gemini text-to-speech model for «بخونش» and the voice briefing.
# Voice-out is the dedicated Gemini TTS engine: it runs only while Gemini is
# the ACTIVE provider; with OpenRouter active the bot explains this instead.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Messages per user per minute before the gateway asks them to slow down (min 5).
RATE_LIMIT_PER_MINUTE=20
